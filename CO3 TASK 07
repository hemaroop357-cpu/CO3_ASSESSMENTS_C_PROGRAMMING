
#include <stdio.h>

#define MAX_CANDIDATES 12
#define MAX_VOTES 500000

struct Candidate
{
    int number;
    int votes;
};

void sort_results(struct Candidate a[], int n)
{
    for (int i = 0; i < n - 1; i++)
    {
        int best = i;

        for (int j = i + 1; j < n; j++)
        {
            if (a[j].votes > a[best].votes)
                best = j;
        }

        if (best != i)
        {
            struct Candidate temp = a[i];
            a[i] = a[best];
            a[best] = temp;
        }
    }
}

int main()
{
    int candidates = 5;

    // INPUT VALUES: 20 VOTES
    int votes[20] = {
        1, 2, 3, 2, 4,
        3, 2, 5, 1, 3,
        2, 4, 3, 2, 1,
        3, 5, 2, 3, 0
    };

    int counts[MAX_CANDIDATES + 1] = {0};

    int valid = 0, invalid = 0;

    struct Candidate results[MAX_CANDIDATES];

    // Count votes
    for (int i = 0; i < 20; i++)
    {
        if (votes[i] >= 1 && votes[i] <= candidates)
        {
            counts[votes[i]]++;
            valid++;
        }
        else
        {
            invalid++;
        }
    }

    // Store candidate results
    for (int i = 0; i < candidates; i++)
    {
        results[i].number = i + 1;
        results[i].votes = counts[i + 1];
    }

    // Sort candidates by votes
    sort_results(results, candidates);

    printf("STUDENT COUNCIL ELECTION RESULTS\n");

    printf("\nTotal Votes: 20\n");
    printf("Valid Votes: %d\n", valid);
    printf("Invalid Votes: %d\n", invalid);

    printf("\nCandidate Vote Details:\n");

    for (int i = 0; i < candidates; i++)
    {
        printf("Candidate %d: %d votes\n",
               results[i].number,
               results[i].votes);
    }

    // Find winner or tie
    if (results[0].votes == 0)
    {
        printf("\nNo valid votes. No winner.\n");
    }
    else
    {
        int tie = 0;

        for (int i = 1; i < candidates; i++)
        {
            if (results[i].votes == results[0].votes)
                tie = 1;
            else
                break;
        }

        if (tie)
        {
            printf("\nElection Result: TIE\n");
            printf("Candidates:");

            for (int i = 0; i < candidates; i++)
            {
                if (results[i].votes == results[0].votes)
                    printf(" %d", results[i].number);
            }

            printf("\nVotes each: %d\n",
                   results[0].votes);
        }
        else
        {
            printf("\nWinner: Candidate %d\n",
                   results[0].number);

            printf("Votes: %d\n",
                   results[0].votes);
        }
    }

    return 0;
}
