
#include <stdio.h>
#include <string.h>

#define MAX_NAMES 500
#define NAME_LENGTH 30

void sort_names(char names[][NAME_LENGTH], int n)
{
    char temp[NAME_LENGTH];

    for (int i = 0; i < n - 1; i++)
    {
        for (int j = 0; j < n - 1 - i; j++)
        {
            if (strcmp(names[j], names[j + 1]) > 0)
            {
                strcpy(temp, names[j]);
                strcpy(names[j], names[j + 1]);
                strcpy(names[j + 1], temp);
            }
        }
    }
}

int binary_search(char names[][NAME_LENGTH],
                  int n, char key[])
{
    int low = 0, high = n - 1;

    while (low <= high)
    {
        int mid = low + (high - low) / 2;

        int result = strcmp(names[mid], key);

        if (result == 0)
            return mid;
        else if (result < 0)
            low = mid + 1;
        else
            high = mid - 1;
    }

    return -1;
}

void find_duplicates(char names[][NAME_LENGTH], int n)
{
    int found = 0;

    printf("\nDuplicate Names:\n");

    for (int i = 1; i < n; i++)
    {
        if (strcmp(names[i], names[i - 1]) == 0)
        {
            if (i == 1 ||
                strcmp(names[i], names[i - 2]) != 0)
            {
                printf("%s\n", names[i]);
                found = 1;
            }
        }
    }

    if (!found)
        printf("No duplicates found.\n");
}

int main()
{
    // INPUT VALUES
    char names[10][NAME_LENGTH] = {
        "Rahul",
        "Amit",
        "Priya",
        "Sneha",
        "Rahul",
        "Kiran",
        "Arjun",
        "Priya",
        "Vijay",
        "Neha"
    };

    int n = 10;

    // Search name input
    char key[] = "Rahul";

    printf("Original Hostel Directory:\n");

    for (int i = 0; i < n; i++)
        printf("%s\n", names[i]);

    // Sort names
    sort_names(names, n);

    printf("\nNames in Alphabetical Order:\n");

    for (int i = 0; i < n; i++)
        printf("%s\n", names[i]);

    // Find duplicate names
    find_duplicates(names, n);

    // Binary search
    int position = binary_search(names, n, key);

    printf("\nSearching for: %s\n", key);

    if (position != -1)
        printf("%s found at index %d\n",
               key, position);
    else
        printf("%s not found\n", key);

    return 0;
}
