
#include <stdio.h>

#define DISTRICTS 38
#define MONTHS 12

void calculate_totals(double rain[DISTRICTS][MONTHS],
                      double totals[DISTRICTS])
{
    for (int i = 0; i < DISTRICTS; i++)
    {
        totals[i] = 0;

        for (int j = 0; j < MONTHS; j++)
        {
            totals[i] += rain[i][j];
        }
    }
}

double calculate_average(double rain[DISTRICTS][MONTHS])
{
    double total = 0;

    for (int i = 0; i < DISTRICTS; i++)
    {
        for (int j = 0; j < MONTHS; j++)
        {
            total += rain[i][j];
        }
    }

    return total / (DISTRICTS * MONTHS);
}

void find_wettest(double rain[DISTRICTS][MONTHS])
{
    double max = rain[0][0];
    int district = 0, month = 0;

    for (int i = 0; i < DISTRICTS; i++)
    {
        for (int j = 0; j < MONTHS; j++)
        {
            if (rain[i][j] > max)
            {
                max = rain[i][j];
                district = i;
                month = j;
            }
        }
    }

    printf("\nWettest District: %d\n", district + 1);
    printf("Wettest Month: %d\n", month + 1);
    printf("Maximum Rainfall: %.2f mm\n", max);
}

